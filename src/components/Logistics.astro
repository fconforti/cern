---
/** Riquadri della logistica in home: icona neon, titolo, dettagli e link utili. */
type Tile = {
	icon: keyof typeof icons;
	label: string;
	title: string;
	lines: string[];
	link?: { href: string; text: string };
	color: string;
};

const icons = {
	bed: '<path d="M3 19v-8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8"/><path d="M3 15h18"/><path d="M6 9V7.5A1.5 1.5 0 0 1 7.5 6h3A1.5 1.5 0 0 1 12 7.5V9"/>',
	pin: '<path d="M12 21.5s7-6.1 7-11.5a7 7 0 0 0-14 0c0 5.4 7 11.5 7 11.5z"/><circle cx="12" cy="10" r="2.5"/>',
	train: '<rect x="5" y="3" width="14" height="13" rx="3"/><path d="M5 10h14"/><path d="M9 20l1.5-4M15 20l-1.5-4"/><circle cx="9" cy="13" r=".6"/><circle cx="15" cy="13" r=".6"/>',
	atom: '<circle cx="12" cy="12" r="1.6"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>',
	thermo: '<path d="M14 14.8V5a2 2 0 0 0-4 0v9.8a4 4 0 1 0 4 0z"/><path d="M12 9v7"/><path d="M18.5 4.5l2 2M20.5 4.5l-2 2M19.5 3.5v4M17.5 5.5h4"/>',
	card: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19"/><path d="M6 15h4"/>',
	id: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="11" r="2"/><path d="M6 16c.6-1.4 1.7-2 3-2s2.4.6 3 2"/><path d="M14.5 10h4M14.5 13h3"/>',
	chat: '<path d="M21 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.7A8 8 0 1 1 21 11.5z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>',
};

const tiles: Tile[] = [
	{
		icon: 'bed', color: 'var(--fam-cyan)', label: 'Dormiamo', title: 'Hotel Auteuil Manotel',
		lines: ['Rue de Lausanne 33, quartiere dei Pâquis. 4 minuti dalla stazione, 10 dal lago.', 'Due camere familiari comunicanti. Colazione 7-11 nel weekend; la sera niente ristorante, ma il quartiere ne è pieno.'],
		link: { href: 'https://www.google.com/maps/search/?api=1&query=Hotel+Auteuil+Manotel+Rue+de+Lausanne+33+Geneve', text: 'Apri in Maps' },
	},
	{
		icon: 'pin', color: 'var(--fam-pink)', label: 'Ci muoviamo', title: 'A piedi, e tram gratis',
		lines: ['La Geneva Transport Card ce la dà l’hotel: tram, bus e battelli gialli gratis per tutto il soggiorno.', 'Per il CERN: tram 18 dalla fermata Môle, 25 minuti fino al capolinea Meyrin, CERN.'],
	},
	{
		icon: 'train', color: 'var(--fam-orange)', label: 'Treni', title: 'Firenze ⇄ Ginevra',
		lines: ['Andata sabato 30: Firenze 10:00, cambio a Milano, Ginevra 17:20. Sedersi a sinistra.', 'Ritorno lunedì 1: Ginevra 11:39, cambio a Milano 16:10, Firenze verso le 18.', 'Orari indicativi: quelli del 2027 escono a dicembre.'],
	},
	{
		icon: 'atom', color: 'var(--fam-green)', label: 'Science Gateway', title: 'Gratis, 9-17',
		lines: ['Aperto da martedì a domenica, ultimo ingresso 16:30. Registrazione online consigliata fino a un mese prima.', 'Visite guidate dai 12 anni e laboratori si prenotano solo sul posto, dal telefono.'],
		link: { href: 'https://visit.cern/', text: 'visit.cern' },
	},
	{
		icon: 'thermo', color: 'var(--fam-violet)', label: 'Meteo', title: '2-6 gradi, vento',
		lines: ['Fine gennaio sul lago tira vento. Strati, cappello, sciarpa.', 'Il lago è a 6-7 gradi: per il tuffo dopo la sauna basta il coraggio.'],
	},
	{
		icon: 'card', color: 'var(--fam-cyan)', label: 'Soldi', title: 'Franchi svizzeri',
		lines: ['Le carte funzionano ovunque. Il CERN è gratis; la sauna ai Bains des Pâquis costa 22 CHF.'],
	},
	{
		icon: 'id', color: 'var(--fam-pink)', label: 'Documenti', title: 'Carta d’identità',
		lines: ['La Svizzera è fuori dall’UE ma in Schengen. Serve anche al CERN per la visita guidata, che può passare in Francia.'],
	},
	{
		icon: 'chat', color: 'var(--fam-orange)', label: 'Lingua', title: 'Francese',
		lines: ['Bonjour e merci bastano. Al CERN si parla di tutto, italiano compreso.'],
	},
];
---

<div class="logi not-content">
	{tiles.map((t) => (
		<article class="logi-tile" style={`--c:${t.color}`}>
			<div class="logi-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} />
			</div>
			<div class="logi-body">
				<p class="logi-label">{t.label}</p>
				<h3 class="logi-title">{t.title}</h3>
				{t.lines.map((l) => <p class="logi-line">{l}</p>)}
				{t.link && <a class="logi-link" href={t.link.href} target="_blank" rel="noopener">{t.link.text} ↗</a>}
			</div>
		</article>
	))}
</div>

<style>
	.logi {
		display: grid;
		grid-template-columns: 1fr;
		gap: .75rem;
		margin: 1.25rem 0;
	}
	@media (min-width: 36rem) {
		.logi { grid-template-columns: 1fr 1fr; }
	}
	.logi-tile {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: .9rem;
		align-items: start;
		padding: 1rem 1.1rem;
		border-radius: 16px;
		border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
		background:
			radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--c) 12%, transparent), transparent 60%),
			var(--sl-color-gray-6);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, .02), 0 0 18px color-mix(in srgb, var(--c) 10%, transparent);
	}
	.logi-icon {
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 12px;
		display: grid;
		place-items: center;
		color: var(--c);
		background: color-mix(in srgb, var(--c) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
		filter: drop-shadow(0 0 6px color-mix(in srgb, var(--c) 55%, transparent));
	}
	.logi-icon svg { width: 1.5rem; height: 1.5rem; }
	.logi-label {
		margin: 0;
		font-size: .72rem;
		font-weight: 600;
		letter-spacing: .1em;
		text-transform: uppercase;
		color: var(--c);
	}
	.logi-title {
		margin: .15rem 0 .4rem;
		font-family: var(--sl-font-headings);
		font-size: 1.15rem;
		line-height: 1.25;
		color: var(--sl-color-white);
	}
	.logi-line {
		margin: 0 0 .35rem;
		font-size: .9rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.logi-link {
		display: inline-block;
		margin-top: .3rem;
		padding: .3rem .75rem;
		border-radius: 999px;
		font-size: .82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--c);
		border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
	}
	.logi-link:hover { background: color-mix(in srgb, var(--c) 14%, transparent); }
</style>
