---
interface Props { to: string; label?: string }
const { to, label = 'alla giornata al CERN' } = Astro.props;
---
<p class="countdown-label">Mancano <strong>{label}</strong>:</p>
<div class="countdown not-content" data-to={to} aria-live="polite">
	<div><b data-u="d">–</b><span>giorni</span></div>
	<div><b data-u="h">–</b><span>ore</span></div>
	<div><b data-u="m">–</b><span>minuti</span></div>
	<div><b data-u="s">–</b><span>secondi</span></div>
</div>
<script>
	const box = document.querySelector<HTMLElement>('.countdown');
	if (box) {
		const target = new Date(box.dataset.to ?? '').getTime();
		const cells = Object.fromEntries(
			Array.from(box.querySelectorAll<HTMLElement>('[data-u]')).map((el) => [el.dataset.u, el]),
		);
		const tick = () => {
			let diff = Math.max(0, target - Date.now());
			const d = Math.floor(diff / 864e5); diff -= d * 864e5;
			const h = Math.floor(diff / 36e5); diff -= h * 36e5;
			const m = Math.floor(diff / 6e4); diff -= m * 6e4;
			const s = Math.floor(diff / 1e3);
			cells.d.textContent = String(d);
			cells.h.textContent = String(h).padStart(2, '0');
			cells.m.textContent = String(m).padStart(2, '0');
			cells.s.textContent = String(s).padStart(2, '0');
		};
		tick();
		setInterval(tick, 1000);
	}
</script>
