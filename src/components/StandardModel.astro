---
const quarks = [
	['u', 'up', '2,2 MeV'], ['c', 'charm', '1,3 GeV'], ['t', 'top', '173 GeV'],
	['d', 'down', '4,7 MeV'], ['s', 'strange', '95 MeV'], ['b', 'bottom', '4,2 GeV'],
];
const leptons = [
	['e', 'elettrone', '0,511 MeV'], ['μ', 'muone', '106 MeV'], ['τ', 'tau', '1,8 GeV'],
	['νe', 'neutrino el.', 'quasi 0'], ['νμ', 'neutrino mu.', 'quasi 0'], ['ντ', 'neutrino tau', 'quasi 0'],
];
const bosons = [
	['γ', 'fotone', 'forza elettromagnetica'], ['g', 'gluone', 'forza forte'],
	['Z', 'bosone Z', 'forza debole'], ['W', 'bosone W', 'forza debole'],
];
---
<div class="sm not-content" role="table" aria-label="Le particelle del Modello Standard">
	<div class="sm-head">Quark (si uniscono per formare protoni e neutroni) · 1ª, 2ª e 3ª generazione</div>
	{quarks.slice(0, 3).map(([s, n, m]) => <div class="sm-cell quark"><span class="sym">{s}</span><span class="name">{n}</span><span class="sub">{m}</span></div>)}
	<div class="sm-cell boson"><span class="sym">γ</span><span class="name">fotone</span><span class="sub">luce, elettromagnetismo</span></div>
	{quarks.slice(3).map(([s, n, m]) => <div class="sm-cell quark"><span class="sym">{s}</span><span class="name">{n}</span><span class="sub">{m}</span></div>)}
	<div class="sm-cell boson"><span class="sym">g</span><span class="name">gluone</span><span class="sub">incolla i quark</span></div>
	<div class="sm-head">Leptoni (l'elettrone e i suoi cugini)</div>
	{leptons.slice(0, 3).map(([s, n, m]) => <div class="sm-cell lepton"><span class="sym">{s}</span><span class="name">{n}</span><span class="sub">{m}</span></div>)}
	<div class="sm-cell boson"><span class="sym">Z</span><span class="name">bosone Z</span><span class="sub">forza debole</span></div>
	{leptons.slice(3).map(([s, n, m]) => <div class="sm-cell lepton"><span class="sym">{s}</span><span class="name">{n}</span><span class="sub">{m}</span></div>)}
	<div class="sm-cell boson"><span class="sym">W</span><span class="name">bosone W</span><span class="sub">forza debole</span></div>
	<div class="sm-head">E poi, da solo…</div>
	<div class="sm-cell higgs" style="grid-column: 1 / 3"><span class="sym">H</span><span class="name">bosone di Higgs</span><span class="sub">125 GeV · dà la massa alle altre</span></div>
</div>
<p class="sm-legend not-content">
	<span><i style="background:var(--fam-violet)"></i>quark</span>
	<span><i style="background:var(--fam-green)"></i>leptoni</span>
	<span><i style="background:var(--fam-orange)"></i>portatori di forza</span>
	<span><i style="background:var(--fam-pink)"></i>Higgs</span>
</p>
