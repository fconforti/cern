---
/**
 * Il marchio: "50", dove lo zero è l'anello dell'acceleratore con una
 * collisione al centro e un protone in corsa sull'anello.
 */
interface Props { class?: string; glowId?: string }
const { class: className, glowId = 'logo-glow' } = Astro.props;
---
<svg class={className} viewBox="0 0 112 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
	<defs>
		<filter id={glowId} x="-30%" y="-30%" width="160%" height="160%">
			<feGaussianBlur stdDeviation="2.2" result="b" />
			<feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
		</filter>
	</defs>
	<g filter={`url(#${glowId})`} fill="none" stroke-linecap="round" stroke-linejoin="round">
		<path d="M38 10H15l-2.5 19c3.5-2.5 8.5-3.5 12.5-3 8 1 13 7 13 15 0 9-7 15-15 15-6 0-11-3-13.5-8" stroke="#ff7eb6" stroke-width="7" />
		<ellipse cx="80" cy="33" rx="20" ry="23" stroke="#7fd1ff" stroke-width="7" />
		<g stroke-width="2.4">
			<path d="M80 33q5-5 11-7" stroke="#ffb347" />
			<path d="M80 33q-5 6-10 8" stroke="#7ee2a8" />
			<path d="M80 33q2 7 1 12" stroke="#c39bff" />
			<path d="M80 33q-3-6-8-9" stroke="#ffffff" />
			<path d="M80 33q7 2 12 6" stroke="#ff7eb6" />
		</g>
		<circle cx="80" cy="33" r="2.6" fill="#ffffff" stroke="none" />
		<circle cx="94.1" cy="16.7" r="3.4" fill="#ffffff" stroke="none" />
	</g>
</svg>
