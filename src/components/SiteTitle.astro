---
import LogoMark from './LogoMark.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title brand" aria-label="50 anni al CERN, home">
	<span class="brand-text" translate="no">CERN</span>
	<LogoMark class="brand-mark" glowId="brand" />
</a>

<style>
	.brand {
		display: flex;
		align-items: center;
		gap: .3rem;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.brand-mark { height: 2rem; width: auto; flex-shrink: 0; }
	.brand-text {
		font-family: var(--sl-font-headings);
		font-weight: 800;
		font-size: 1.45rem;
		letter-spacing: -.035em;
		line-height: 1;
		color: #ffffff;
		background: none;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
