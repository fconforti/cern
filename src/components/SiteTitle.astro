---
import LogoMark from './LogoMark.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title brand" aria-label="50 anni al CERN, home">
	<LogoMark class="brand-mark" glowId="brand-glow" />
	<span class="brand-text" translate="no">anni al CERN</span>
</a>

<style>
	.brand {
		display: flex;
		align-items: center;
		gap: .55rem;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.brand-mark { height: 2rem; width: auto; flex-shrink: 0; }
	.brand-text {
		font-family: var(--sl-font-headings);
		font-weight: 800;
		font-size: 1.2rem;
		letter-spacing: -.01em;
		color: #f4fbff;
		text-shadow: 0 0 8px rgba(127, 209, 255, .55), 0 0 18px rgba(255, 126, 182, .3);
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.brand:hover .brand-text { text-shadow: 0 0 10px rgba(127, 209, 255, .8), 0 0 24px rgba(255, 126, 182, .5); }
</style>
